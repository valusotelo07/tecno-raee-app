# Optional: keep these unset to use the existing hosted project.
# For local development, use the values printed by `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Optional for Android development/store builds; restrict the key to your app + SHA-1.
# Expo Go and the web map do not require this key. iOS uses Apple Maps.
# GOOGLE_MAPS_ANDROID_API_KEY=replace-with-restricted-android-maps-key

# Optional address suggestions in the point editor. Restrict domains and quotas in Geoapify.
# Manual map selection works without this key. Put the real value in .env.local.
# EXPO_PUBLIC_GEOAPIFY_KEY=your-restricted-client-key
